# --- Base de données ---------------------------------------------------------
# Laisser vide en local : l'app démarre sur PGlite (Postgres embarqué, zéro config).
# En production, coller l'URL "Connection string" du projet Supabase :
# DATABASE_URL="postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:6543/postgres"
DATABASE_URL=

# --- Sécurité ----------------------------------------------------------------
# Clé de signature des sessions admin. Générer avec : openssl rand -base64 32
AUTH_SECRET="dev-secret-a-changer-absolument-en-production"

# --- Site --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Paiement en ligne (V2) --------------------------------------------------
# Laisser vide en V1 : le paiement se fait à la récupération / livraison.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
